<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005" author="Robert">

        <createTable tableName="exactly_once_delivery_entry">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="message_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="exactly_once_delivery_entry_message_id_idx"
                     tableName="exactly_once_delivery_entry" unique="true">
            <column name="message_id"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="exactly_once_delivery_entry_message_id_idx" tableName="exactly_once_delivery_entry"/>
            <dropTable tableName="exactly_once_delivery_entry"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
