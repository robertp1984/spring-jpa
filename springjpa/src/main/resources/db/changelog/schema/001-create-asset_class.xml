<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001" author="Robert">

        <createTable tableName="asset_class">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="VARCHAR(1024)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="asset_class_name_idx"
                     tableName="asset_class" unique="true">
            <column name="name"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="asset_class_name_idx" tableName="asset_class"/>
            <dropTable tableName="asset_class"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

